{
  "name": "@dustwave/podcast",
  "version": "0.2.3",
  "private": true,
  "description": "Dust Wave podcast API, media orchestration, premium feeds, and publishing jobs",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "types": "wrangler types --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run security:secrets && npm run security:audit && npm run types && npm run typecheck && npm test",
    "security:secrets": "node shared/dust-wave-platform/scripts/scan-tracked-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "fixtures:virtual-audio": "node scripts/generate-virtual-audio-fixtures.mjs",
    "matrix:virtual-audio": "node scripts/run-virtual-audio-protocol-matrix.mjs",
    "load:virtual-audio": "node scripts/run-virtual-audio-load-gate.mjs",
    "gate:virtual-audio:staging": "node scripts/run-virtual-audio-staging-gate.mjs",
    "gate:sponsor-demo": "node scripts/run-direct-sponsor-demo-gate.mjs",
    "gate:episode:staging": "node scripts/check-episode-staging-gate.mjs",
    "gate:stripe:staging": "node scripts/check-stripe-staging-readiness.mjs",
    "gate:launch:staging": "node scripts/check-launch-staging-readiness.mjs",
    "launch-lab": "node scripts/launch-lab-client.mjs",
    "launch-lab:contracts": "node scripts/build-launch-lab-contract-observations.mjs",
    "launch-lab:probe": "node scripts/probe-launch-lab-public-boundary.mjs",
    "prepare:alignment-benchmark-source": "node scripts/prepare-alignment-benchmark-source.mjs",
    "audit:transcript-reference": "node scripts/audit-transcript-reference.mjs",
    "deploy:staging:dry": "wrangler deploy --env staging --dry-run",
    "deploy:production:dry": "wrangler deploy --env production --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@dustwave/admin-shell": "file:shared/dust-wave-platform/packages/admin-shell",
    "@dustwave/media-core": "file:shared/dust-wave-platform/packages/media-core",
    "@dustwave/tax-core": "file:shared/dust-wave-platform/packages/tax-core",
    "@dustwave/timed-text": "file:shared/dust-wave-platform/packages/timed-text",
    "@dustwave/worker-core": "file:shared/dust-wave-platform/packages/worker-core"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260729.1",
    "@types/node": "^26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  },
  "engines": {
    "node": ">=22"
  }
}
